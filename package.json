{
  "name": "starbottons",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "edge": "supabase functions serve --env-file supabase/functions/.env",
    "dev": "concurrently -n edge,web -c magenta,cyan --restart-tries 1000 --restart-after 2000 \"npm:edge\" \"npm:start\"",
    "setup": "node scripts/setup.mjs",
    "up": "node scripts/up.mjs",
    "fix:clock": "node scripts/fix-clock.mjs",
    "models:fetch": "node scripts/fetch-models.mjs",
    "models:smoke": "node scripts/smoke-model.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource/fredoka": "^5.3.0",
    "@supabase/supabase-js": "^2.110.8",
    "jszip": "^3.10.1",
    "onnxruntime-web": "1.31.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.6.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
