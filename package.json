{
  "name": "starbottons",
  "version": "1.2.14",
  "description": "Star Bottons — gerador de artes e mockups de bottons (app desktop local).",
  "author": "Star Bottons",
  "main": "electron/main.cjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "edge": "supabase functions serve --env-file supabase/functions/.env",
    "dev": "concurrently -n edge,web -c magenta,cyan --restart-tries 1000 --restart-after 2000 \"npm:edge\" \"npm:start\"",
    "setup": "node scripts/setup.mjs",
    "up": "node scripts/up.mjs",
    "fix:clock": "node scripts/fix-clock.mjs",
    "models:fetch": "node scripts/fetch-models.mjs",
    "models:smoke": "node scripts/smoke-model.mjs",
    "electron": "electron electron/main.cjs",
    "desktop": "node scripts/start-electron.mjs",
    "preview": "ng build && electron electron/main.cjs",
    "dist": "ng build && electron-builder",
    "dist:dir": "ng build && electron-builder --dir",
    "dist:publish": "ng build && electron-builder --publish always"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@fontsource/fredoka": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "^6.8.11",
    "imagescript": "^3.20.5",
    "jszip": "^3.10.2",
    "onnxruntime-web": "1.31.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "angular-eslint": "22.7.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^4.1.12"
  }
}
